//#define PRESSURE_ABS_SENSOR_RANGE_PSI        0.3 // orig 0.15                          // 0 digit  
//#define PRESSURE_DIFF_SENSOR_RANGE_PSI       0.3 // orig 0.075                         // 0 digit
//#define PRESSURE_ABS_SENSOR_RANGE_PSI        0.029                           // 0 digit  
//#define PRESSURE_DIFF_SENSOR_RANGE_PSI       0.01450                         // 0 digit
#define PRESSURE_ABS_SENSOR_RANGE_PSI        (GetParameterValue(PRES_ABS_RANGE)/6895.7)  // Pa to PSI conversion
//#define PRESSURE_ABS_SENSOR_RANGE_PSI        (100/6895.7)  // Pa to PSI conversion
#define PRESSURE_DIFF_SENSOR_RANGE_PSI       (GetParameterValue(PRES_DIFF_RANGE)/6895.7)  // 0 digit
//#define PRESSURE_DIFF_SENSOR_RANGE_PSI       (100/6895.7)  // 0 digit

#define PRESSURE_ABS_SENSOR_RANGE_MILLIBAR   (PRESSURE_ABS_SENSOR_RANGE_PSI*68.9476)    // 2 digit
#define PRESSURE_DIFF_SENSOR_RANGE_MILLIBAR  (PRESSURE_DIFF_SENSOR_RANGE_PSI*68.9476)   // 1 digit
#define PRESSURE_ABS_SENSOR_RANGE_PA         (PRESSURE_ABS_SENSOR_RANGE_PSI*6894.76)    // 3 digit
#define PRESSURE_DIFF_SENSOR_RANGE_PA        (PRESSURE_DIFF_SENSOR_RANGE_PSI*6894.76)   // 3 digit
#define PRESSURE_ABS_SENSOR_RANGE_H2O_MM     (PRESSURE_ABS_SENSOR_RANGE_PSI*703.069578295612)    // 3 digit
#define PRESSURE_DIFF_SENSOR_RANGE_H2O_MM    (PRESSURE_DIFF_SENSOR_RANGE_PSI*703.069578295612)   // 2 digit
#define PRESSURE_ABS_SENSOR_RANGE_H2O_INCH   (PRESSURE_ABS_SENSOR_RANGE_PSI*27.7076)   // 1 Digit
#define PRESSURE_DIFF_SENSOR_RANGE_H2O_INCH  (PRESSURE_DIFF_SENSOR_RANGE_PSI*27.7076)  // 1 Digit
#define PRESSURE_ABS_SENSOR_RANGE_HG_INCH    (PRESSURE_ABS_SENSOR_RANGE_PSI*2.03602)     // 0 digit
#define PRESSURE_DIFF_SENSOR_RANGE_HG_INCH   (PRESSURE_DIFF_SENSOR_RANGE_PSI*2.03602)    // 0 digit
#define PRESSURE_ABS_SENSOR_RANGE_PSF        (PRESSURE_ABS_SENSOR_RANGE_PSI*144.0)     // 2 digit
#define PRESSURE_DIFF_SENSOR_RANGE_PSF       (PRESSURE_DIFF_SENSOR_RANGE_PSI*144.0)    // 2 digit

   /* Converts and formats the sting for output */
static void FormatAbsPressure(uint8_t unit, int16_t value)
{
   double result;
   uint8_t decimal; // minimum value is 1

   if (IsLCDDisplay())
   {
      if( unit == (uint8_t)PRESSURE_MILIBAR )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_MILLIBAR) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("mBAR");
         decimal = 4;
      }
      else if( unit == (uint8_t)PRESSURE_PA )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_PA) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("Pa");
         if( result > -0.1 && result < 0 )
           result = 0;
         decimal = 2;
      }
      else if( unit == (uint8_t)PRESSURE_HG_INCH )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_HG_INCH) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("iHg");
         decimal = 5;
      }
      else if( unit == (uint8_t)PRESSURE_PSF )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_PSF) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("PSF");
         decimal = 3;
      }
      else if( unit == (uint8_t)PRESSURE_H2O_MM )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_H2O_MM) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("mH2O");
         decimal = 3;
      }
      else if( unit == (uint8_t)PRESSURE_H2O_INCH )
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_H2O_INCH) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("iH2O");
             decimal = 4;
      }
      else if( unit == (uint8_t)PRESSURE_CFM )
      {
	     result = ( value < 0 )? -1 : 1;  // Polarity adjustment
         result = result * 4005.0 * sqrt(result * value * (PRESSURE_ABS_SENSOR_RANGE_H2O_INCH) / PRESSURE_ABS_SENSOR_RESOLUTION) * GetParameterValue(PRES_ABS_AREA) / 1000.0;
         formatedUnit = PSTR("CFM");
         decimal = 1;
      }
      else
      {
         result = value * (PRESSURE_ABS_SENSOR_RANGE_PSI) / PRESSURE_ABS_SENSOR_RESOLUTION;
         formatedUnit = PSTR("PSI");
         decimal = 5;
      }

      dtostrf( result, sizeof(formatedValue)-1, decimal, formatedValue);
      strcpy( formatedValue, strtrim(formatedValue));
   }
   return;
}

/* Converts and formats the sting for output */
static void FormatDiffPressure(uint8_t unit, int16_t value)
{
   double result;
   uint8_t decimal;  // minimum value is 1

   if (IsLCDDisplay())
   {
      if( unit == (uint8_t)PRESSURE_MILIBAR )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_MILLIBAR) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_MILLIBAR);
         formatedUnit = PSTR("mBAR");
         decimal = 4;
      }
      else if( unit == (uint8_t)PRESSURE_PA )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PA) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PA);
         formatedUnit = PSTR("Pa");
         if( result > -0.1 && result < 0 )
           result = 0;
         decimal = 2;
      }
      else if( unit == (uint8_t)PRESSURE_HG_INCH )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_HG_INCH) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_HG_INCH);
         formatedUnit = PSTR("iHg");
         decimal = 5;
      }
      else if( unit == (uint8_t)PRESSURE_PSF )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PSF) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PSF);
         formatedUnit = PSTR("PSF");
         decimal = 3;
      }
      else if( unit == (uint8_t)PRESSURE_H2O_MM )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_H2O_MM) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_H2O_MM);
         formatedUnit = PSTR("mmH2O");
         decimal = 3;
      }
      else if( unit == (uint8_t)PRESSURE_H2O_INCH )
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_H2O_INCH) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_H2O_INCH);
         formatedUnit = PSTR("iH2O");
             decimal = 4;
      }
      else if( unit == (uint8_t)PRESSURE_CFM )
      {
         result = 4005.0 * sqrt(value * (PRESSURE_DIFF_SENSOR_RANGE_H2O_INCH) / PRESSURE_DIFF_SENSOR_RESOLUTION) * GetParameterValue(PRES_DIFF_AREA) / 1000.0;
         formatedUnit = PSTR("CFM");
         decimal = 1;
      }
      else
      {
         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PSI) / PRESSURE_DIFF_SENSOR_RESOLUTION;
//         result = value * (PRESSURE_DIFF_SENSOR_RANGE_PSI);
         formatedUnit = PSTR("PSI");
         decimal = 5;
      }

      dtostrf( result, sizeof(formatedValue)-1, decimal, formatedValue);
      strcpy( formatedValue, strtrim(formatedValue));
   }
   return;
}



/* Converts and formats the sting for output */
static void FormatTemperature(int16_t value)
{
   double result;
   tempUnit = GetParameterValue( TEMPERATURE_UNIT );

   if (IsLCDDisplay())
   {
      if( tempUnit == TEMPERATURE_DEG_F )
      {
         formatedUnit = PSTR("*F");
         result = ((double)value * 9 / 500) + 32;
      }
      else if( tempUnit == TEMPERATURE_DEG_K )
      {
         formatedUnit = PSTR("*K");
         result = value / 100.0 + 273.15;
      }
      else
      {
         formatedUnit = PSTR("*C");
         result = value / 100.0;
      }

      dtostrf( result, sizeof(formatedValue)-1, 2, formatedValue);
      strcpy( formatedValue, strtrim(formatedValue));
   }
   return;
}

/* Converts and formats the sting for output */
static void FormatHumidity(int16_t value)
{
   double result;

   humidityUnit = GetParameterValue( HUMIDITY_UNIT );

   if (IsLCDDisplay())
   {
      formatedUnit = PSTR("%RH");
      result = value / 100.0;
      dtostrf( result, sizeof(formatedValue)-1, 2, formatedValue);
      strcpy( formatedValue, strtrim(formatedValue));
   }
   return;
}

static void FormatControlOutput( char * str, int value)
{
   locked_sprintf_P( str, PSTR("Output:%d.%d%%"), (int)(value/10), (int)(value%10));
}

static TIME curTime; 
static char dispValSel = 0;
/* formats the sting for output */
char * FormatSystemError( char * str, int16_t value )
{
   if (IsLCDDisplay())
   {
      if( value == ERROR_OK )
         dispValSel = (dispValSel + 1) %2;
      else
         dispValSel = (dispValSel + 1) %3;

      if( dispValSel == (char)0)
      {
         if( RTCGetTime( &curTime ) == ERROR_OK )
         {
            displayStr[0] = ' ';
            displayStr[1] = (curTime.hours >> 4) + '0';
            displayStr[2] = (curTime.hours & 0xf ) + '0';
            displayStr[3] = ':';
            displayStr[4] = (curTime.minutes >> 4) + '0';
            displayStr[5] = (curTime.minutes & 0xf ) + '0';
            displayStr[6] = ':';
            displayStr[7] = (curTime.seconds >> 4) + '0';
            displayStr[8] = (curTime.seconds & 0xf ) + '0';
            displayStr[9] = 0;
         }
         else
            dispValSel++;
        }
      if( dispValSel == (char)1)
         locked_sprintf_P( str, PSTR("www.sapindia.in"));
      if( dispValSel == (char)2)
         locked_sprintf_P( str, PSTR("SYSTEM ERR:%d"), value );
   }
   return str;
}

/* formats the sting for output */
static void FormatDispError( int8_t error )
{
   if (IsLCDDisplay())
      locked_sprintf_P( formatedValue, PSTR("ER.%d"), error );
   return;
}

/* formats the sting for output */
static void FormatError( int8_t error )
{
   if (IsLCDDisplay())
      locked_sprintf_P( formatedValue, PSTR("ERR %d"), error );
   return;
}

/* formats the sting for output */
static char * FormatInteger( int16_t value)
{
   if (IsLCDDisplay())
   {
      locked_sprintf_P( displayStr, PSTR("%d"), value );
      return displayStr;
   }
   return NULL;
}

static char * FormatVersion()
{
    int major = SOFTWARE_VERSION/100;
    int minor = SOFTWARE_VERSION%100;
    if( minor < 10 )
       locked_sprintf_P( formatedValue, PSTR("%d.0%d"), major, minor );
    else
       locked_sprintf_P( formatedValue, PSTR("%d.%d"), major, minor );

    return formatedValue;
}


char * FormatPresAbsOneLine( char * str, uint8_t error, int16_t value )
{
   FormatAbsPressure( GetParameterValue( PRESSURE_ABS_UNIT ), value );
   if( error != ERROR_OK )
      FormatError( error );
//**   locked_sprintf_P( str, PSTR("P-A(%S): %s"), formatedUnit, formatedValue );
   locked_sprintf_P( str, PSTR("DP1(%S): %s"), formatedUnit, formatedValue );
   return str;
}

char * FormatPresDiffOneLine( char * str, uint8_t error, int16_t value )
{
   FormatDiffPressure( GetParameterValue( PRESSURE_DIFF_UNIT ), value );
   if( error != ERROR_OK )
      FormatError( error );
//   locked_sprintf_P( str, PSTR("P-D(%S): %s"), formatedUnit, formatedValue );
   locked_sprintf_P( str, PSTR("DP2(%S): %s"), formatedUnit, formatedValue );
   return str;
}

char * FormatTemperatureOneLine( char * str, uint8_t error, int16_t value )
{
   FormatTemperature( value );
   if( error != ERROR_OK )
      FormatError( error );
   locked_sprintf_P( str, PSTR("TEMP(%S): %s"), formatedUnit, formatedValue );
   return str;
}

char * FormatHumidityOneLine( char * str, uint8_t error, int16_t value )
{
   FormatHumidity( value );
   if( error != ERROR_OK )
      FormatError( error );
   locked_sprintf_P( str, PSTR("HUMI(%S): %s"), formatedUnit, formatedValue );
   return str;
}



