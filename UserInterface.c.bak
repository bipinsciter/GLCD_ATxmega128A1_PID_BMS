static uint8_t isMasterReset;

static int16_t configPassword;

static int tempUnit, humidityUnit;

static char displayStr[30];
static char formatedValue[12];
static const char * formatedUnit;

static char prevKeys, currKeys, keys, keysPressed;

static uint8_t timer, curDisplay;
static SENSOR_VALUE senVal;
static uint8_t dispList[4], noOfSensors;

static OSSemaMutex UIMutex;

unsigned int keybrdIdleTimer;

#define USERTASK_STACK_SIZE   150
#define USERTASK_PRIORITY     3

#ifdef OS_AVRX
static TimerControlBlock uioSleepTimer;
AVRX_GCC_TASKDEF(UserInterfaceTask, USERTASK_STACK_SIZE, USERTASK_PRIORITY)
#endif
#ifdef OS_FREERTOS
void UserInterfaceTask( void * taskPara );

void UserInterfaceTask( void * taskPara )
#endif
{
   AvrXDelay(&uioSleepTimer, 4000);

   keybrdIdleTimer = 0;
   StartDisplaySensorValues();
   while (1)
   {
#ifdef OS_AVRX
      AvrXDelay(&uioSleepTimer, KEYBOARD_LOOP_TIME);
#else
      OSSleep(KEYBOARD_LOOP_TIME);
#endif
      currKeys = (~KEYPAD_PORT_IN) & KEYS_ALL_MASK;
      keysPressed = keys;
      keys |= (currKeys & prevKeys);
      keys &= (currKeys | prevKeys);
      prevKeys = currKeys;

      keysPressed = (keys^keysPressed) & keys;

      if( keysPressed & MODE_SEL_KEY )
      {
         if( LCDControl == SENSOR_VALUES )
            DisplayEditor( -1, -1 );
         else if ( LCDControl == EDITOR )
         {
            if( IsLoggingEnabled() )
               DisplayLog(-1, -1);
            else
               StartDisplaySensorValues();
         }
         else
            StartDisplaySensorValues();
         keybrdIdleTimer = 0;
      }

      if( LCDControl == (unsigned char)SENSOR_VALUES )
	  {
	     if(( keysPressed & UP_KEY ) && ( keysPressed & DOWN_KEY ))
		    SetBuzzerSuppressionReq();   // Supress buzzer request (valid when displaying sensor values)
         continue;
	  }

      if( LCDControl == (unsigned char)EDITOR )
         currKeys = KEYS_EDITOR_MASK;
      else if( LCDControl == (unsigned char)SYSTEM_LOG )
         currKeys = ( UP_KEY | DOWN_KEY );

      if(( keys & currKeys ) == 0)
      {
         keybrdIdleTimer++;
         if( keybrdIdleTimer >= KEYBOARD_IDLE_TIME/KEYBOARD_LOOP_TIME)
            StartDisplaySensorValues();
      }
      else
      {
         keybrdIdleTimer = 0;
         if( LCDControl == (unsigned char)EDITOR )
            DisplayEditor( keysPressed & KEYS_EDITOR_MASK, keys & KEYS_EDITOR_MASK );
        else if( LCDControl == (unsigned char)SYSTEM_LOG )
            DisplayLog( keysPressed & ( UP_KEY | DOWN_KEY ), keys & ( UP_KEY | DOWN_KEY ));
      }
   }
}


void UserInterfaceInit()
{
   isMasterReset = 0;
   configPassword = 0;

   KEYPAD_PORT_DIR  &= ~KEYS_ALL_MASK;
   KEYPAD_PORT |= KEYS_ALL_MASK;

   SETDFLTSW_PORT_DIR  &= ~_BV(SETDFLTSW_BIT);
   SETDFLTSW_PORT |= _BV(SETDFLTSW_BIT);

   BUZZER_PORT_DIR  |=  _BV(BUZZER_BIT);
   BUZZER_PORT &= ~_BV(BUZZER_BIT);

   prevKeys = 0;
   currKeys = 0;
   keys = 0;
   keysPressed = 0;

   if (IsLCDDisplay())
   {
      systemXLoc = 0;
      OSSemaCreateMutex(UIMutex);
      OSSemaGive(UIMutex);
      OSSemaTakeEver(UIMutex);
      // Initialize the LCD
      ks0xxx_Init(0);
      ks0xxx_Init(0);
      // Select a font
      ks0xxx_SelectFont(Font6x8, ks0xxx_ReadFontData, BLACK);
      // Print SAP India
      locked_sprintf_P( displayStr, PSTR("info@sapindia.in"));
      PrintLineCentered( 10, displayStr );
      locked_sprintf_P( displayStr, PSTR("NIYAMA"));
      PrintLineCentered( 30, displayStr );
      locked_sprintf_P( displayStr, PSTR("Version: %s"), FormatVersion());
      PrintLineCentered( 40, displayStr );

      systemXLoc = SCREEN_START_X_VAL;
      systemYLoc = SCREEN_START_Y_VAL;

      if(( SETDFLTSW_PORT_IN & _BV(SETDFLTSW_BIT)) == 0)
      {
         // Print Master Reset
         locked_sprintf_P( displayStr, PSTR("Master Reset"));
         PrintLineCentered( 30, displayStr );
         isMasterReset = 1;
         SetAllParametersToDefault();
      }
      OSSemaGive(UIMutex);
   }
#ifdef OS_AVRX
   AvrXRunTask(TCB(UserInterfaceTask));
#endif
#ifdef OS_FREERTOS
   /* Spawn the producer and consumer. */
   xTaskCreate( UserInterfaceTask, "UI", USERTASK_STACK_SIZE, ( void * ) 0, USERTASK_PRIORITY, NULL );
#endif
}


static void StartDisplaySensorValues()
{
   char cnt = 1;

   OSSemaTakeEver(UIMutex);
   noOfSensors = 0;
   if (IsAbsolutePressureEnabled())
      dispList[noOfSensors++] = 0;

   if (IsDiffPressureEnabled())
      dispList[noOfSensors++] = 1;

   if (IsTemperatureEnabled())
      dispList[noOfSensors++] = 2;

   if (IsHumidityEnabled())
      dispList[noOfSensors++] = 3;

   // Y locations for multi-line display mode.
   if (IsAbsolutePressureEnabled())
      presAbsYLoc_disp_mode_all_para = SCREEN_START_Y_VAL + ((SYSERR_Y_OFFSET-SCREEN_START_Y_VAL)/(noOfSensors+1)) * (cnt++) - 7;
   if (IsDiffPressureEnabled())
      presDiffYLoc_disp_mode_all_para = SCREEN_START_Y_VAL + ((SYSERR_Y_OFFSET-SCREEN_START_Y_VAL)/(noOfSensors+1)) * (cnt++) - 7;
   if (IsTemperatureEnabled())
      tempYLoc_disp_mode_all_para = SCREEN_START_Y_VAL + ((SYSERR_Y_OFFSET-SCREEN_START_Y_VAL)/(noOfSensors+1)) * (cnt++) - 7;
   if (IsHumidityEnabled())
      humidityYLoc_disp_mode_all_para = SCREEN_START_Y_VAL + ((SYSERR_Y_OFFSET-SCREEN_START_Y_VAL)/(noOfSensors+1)) * (cnt++) - 7;

   if( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA )
   {  // select small fonts for onetime as there is no change in font in each line 
      ks0xxx_SelectFont( smallFont, ks0xxx_ReadFontData, BLACK);
   }
   ks0xxx_ClearScreen();
   curDisplay = 0;
   timer = 0;
   OSSemaGive(UIMutex);
   LCDControl = SENSOR_VALUES;
//   DisplaySensorValues();
}


void DisplaySensorValues()
{
   static char noSystemErrDisp = 0;

   if (IsLCDDisplay())
   {
      if ( LCDControl != SENSOR_VALUES || noOfSensors == 0 )
         return;


      if( timer == 0 || GetParameterValue( DISPLAY_MODE ))
      {
         if( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA) // process all parameters in once (if multi line dispaly)
            curDisplay = 0;                // Start with display 0, override current display value as it is invalid
         do
         {
            switch( dispList[curDisplay] )
            {
               case 0:
                  GetAbsPressure( &senVal );
                  if( abs(senVal.convertedValue) < GetParameterValue( PRES_ABS_ZERO_RNG ))
                     senVal.convertedValue = 0;
                  noSystemErrDisp = DisplayAbsPressure(senVal.errorCode, senVal.convertedValue);
                  break;
               case 1:
                  GetDiffPressure( &senVal );
                  if( abs(senVal.convertedValue) < GetParameterValue( PRES_DIFF_ZERO_RNG ))
                     senVal.convertedValue = 0;
                  noSystemErrDisp = DisplayDiffPressure(senVal.errorCode, senVal.convertedValue);
                  break;
               case 2:
                  GetTemperature( &senVal );
                  noSystemErrDisp = DisplayTemperature(senVal.errorCode, senVal.convertedValue);
                  break;
               case 3:
                  GetHumidity( &senVal );
                  noSystemErrDisp = DisplayHumidity(senVal.errorCode, senVal.convertedValue);
                  break;
            }
            if( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA) // process all parameters in once (if multi line dispaly)
               curDisplay = (curDisplay+1) % noOfSensors;                // proceess all display rows
          }
          while( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA && curDisplay != 0);
      }

      if(!noSystemErrDisp) // if PID control output is not displayed, display this.
         DisplaySystemError(systemError);

      if( timer == 0)
         curDisplay = (curDisplay+1) % noOfSensors;   // This used when only one parameter is displayed
   }

   timer = (timer + 1) % GetParameterValue( DISPLAY_INTERVAL ); // Used only for single parameter display
}


static void DisplayLog(char keysPressed, char keys)
{
   LCDControl = SYSTEM_LOG;
   if (IsLCDDisplay())
   {
////
   }
}

// align = 0; left align
// align = 1; center align
static void PrintLine( uint8_t align, char * str )
{
    uint8_t len = ks0xxx_StringWidth(str);
    uint8_t scrWidth = 127 - systemXLoc, start, spaceWidth = ks0xxx_CharWidth( ' ' ), i;
    if( align == 0 )
       start = 0;
    else
       start = ( scrWidth - len ) / 2;
    for( i = spaceWidth; i < start; i += spaceWidth )
       ks0xxx_PutChar( ' ' );
    ks0xxx_Puts(str);
    for( i = i+len; len < scrWidth; len += spaceWidth )
       ks0xxx_PutChar( ' ' );
}

static void PrintLineCentered( uint8_t yPos, char * str )
{
    uint8_t len;
    uint8_t start;
    uint8_t height = ks0xxx_FontHeight();

    while((len = ks0xxx_StringWidth(str)) > 128)
       str[strlen(str)-1] = 0;   // remove out of screen charaters

    start = 64 - len/2;
    ks0xxx_FillRect(0, yPos, start, height, WHITE);
    ks0xxx_GotoXY(start,yPos);
    ks0xxx_Puts(str);
    ks0xxx_FillRect(start+len, yPos, 128-start-len, height, WHITE);
}



void DisplaySystemError()
{
   if (IsLCDDisplay())
   {
      OSSemaTakeEver(UIMutex);

      // Select a font
      ks0xxx_SelectFont(systemErrorFont, ks0xxx_ReadFontData, BLACK);
      // Print some text
      PrintLineCentered(systemYLoc+SYSERR_Y_OFFSET, FormatSystemError( displayStr, systemError));

      OSSemaGive(UIMutex);
   }
}

char DisplayAbsPressure(uint8_t error, int16_t value)
{
   char noSystemErrDisp = 0;
   if (IsLCDDisplay())
   {
      OSSemaTakeEver(UIMutex);
      if( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA )
	  {
         ks0xxx_SelectFont( Font_Courier_14_Bold, ks0xxx_ReadFontData, BLACK);
         FormatPresAbsOneLine( displayStr, error, value ); 
         if( error == ERROR_OK )
            displayStr[strlen(displayStr)-1] = '\0';  // one digit less resolution then setup
	      PrintLineCentered( presAbsYLoc_disp_mode_all_para, displayStr );
      }
	  else
	  {
	     FormatAbsPressure( GetParameterValue( PRESSURE_ABS_UNIT ), value );
        formatedValue[strlen(formatedValue)-1] = '\0';  // one digit less resolution then setup
		if(formatedValue[strlen(formatedValue)-1] == '.' )
           formatedValue[strlen(formatedValue)-1] = '\0';  // if last digit '.' remove it

        if( error != ERROR_OK )
		     FormatDispError( error );
			// Select a font
		 ks0xxx_SelectFont( smallFont, ks0xxx_ReadFontData, BLACK);
			// Print some text
//**			locked_sprintf_P( displayStr, PSTR( "Pres Gauge %S" ), formatedUnit);
		 locked_sprintf_P( displayStr, PSTR( "Pres Diff 1 %S" ), formatedUnit);
		 PrintLineCentered( systemYLoc, displayStr );
		// Select a font
		 ks0xxx_SelectFont( largeFont, ks0xxx_ReadFontData, BLACK);
 		 PrintLineCentered( systemYLoc+DATA_Y_OFFSET, formatedValue );
         if( IsAlalogOutEnabled() && IsPIDEnabled() && GetParameterValue(PRES_ABS_OUTPUT_TYPE) == 2 && systemError == ERROR_OK )
         {  
		     FormatControlOutput( displayStr, GetAbsPresPIDPercent());
           ks0xxx_SelectFont( smallFont, ks0xxx_ReadFontData, BLACK);
		     PrintLineCentered(systemYLoc+SYSERR_Y_OFFSET, displayStr);
			 noSystemErrDisp = 1;
         }
      }
      OSSemaGive(UIMutex);
   }
   return noSystemErrDisp;
}

char DisplayDiffPressure(uint8_t error, int16_t value)
{
   char noSystemErrDisp = 0;
   if (IsLCDDisplay())
   {
      OSSemaTakeEver(UIMutex);

      if( GetParameterValue( DISPLAY_MODE ) == DISP_MODE_ALL_PARA )
	   {
         ks0xxx_SelectFont( Font_Courier_14_Bold, ks0xxx_ReadFontData, BLACK);

         FormatPresDiffOneLine( displayStr, error, value ); 
         if( error == ERROR_OK )
            displayStr[strlen(displayStr)-1] = '\0';  // one digit less resolution then setup
		   PrintLineCentered( presDiffYLoc_disp_mode_all_para, displayStr );
      }
	  else
	  {
	     FormatDiffPressure( GetParameterValue( PRESSURE_DIFF_UNIT ), value );
         formatedValue[strlen(formatedValue)-1] = '\0';  // one digit less resolution then setup
 		 if(formatedValue[strlen(formatedValue)-1] == '.' )
            formatedValue[strlen(formatedValue)-1] = '\0';  // if last digit '.' remove it
	     if( error != ERROR_OK )
	        FormatDispError( error );

	      // Select a font
	      ks0xxx_SelectFont( smallFont, ks0xxx_ReadFontData, BLACK);
	      // Print some text
//**	      locked_sprintf_P( displayStr, PSTR( "Pres Diff %S" ), formatedUnit);
	      locked_sprintf_P( displayStr, PSTR( "Pres Diff 2 %S" ), formatedUnit);
	      PrintLineCentered( systemYLoc, displayStr );
	      // Select a font
	      ks0xxx_SelectFont( largeFont, ks0xxx_ReadFontData, BLACK);
	      PrintLineCentered( systemYLoc+DATA_Y_OFFSET, formatedValue );
         if( IsAlalogOutEnabled() && IsPIDEnabled() && GetParameterValue(PRES_DIFF_OUTPUT_TYPE) == 2 && systemError == ERROR_OK )
         {  
		     FormatControlOutput( displayStr, GetDiffPresPIDPercent());
           ks0xxx_SelectFont( smallFont, ks0xxx_ReadFontData, BLACK);
		     PrintLineCentered(systemYLoc+SYSERR_Y_OFFSET, displayStr);
 			  noSystemErrDisp = 1;
         }
		}
      OSSemaGive(UIMutex);
   }
   return noSystemErrDisp;
}

